ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=mxxsicbeat

REDIS_URL=redis://redis:6379

MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1

MAPS_STORAGE_SONGS_BUCKET=songs
# Public CDN host in front of the bucket's public-read `{job_id}/original/` objects, e.g.
# https://cdn.example.com. Leave unset to omit audio_url from beatmap responses.
# The `cdn` service in docker-compose.yml (nginx caching proxy, docker/nginx.conf) serves
# this locally on :8080.
MAPS_STORAGE_PUBLIC_BASE_URL=http://localhost:8080

MAX_UPLOAD_SIZE_MB=30
DEFAULT_LANE_COUNT=2
MAX_LANE_COUNT=8

# Per-queue BullMQ retry policy for the beatmap-generation flow. Each queue has its own prefix
# so e.g. demucs separation can retry less aggressively than the cheap beatmap merge step.
# Defaults (3 attempts, exponential backoff starting at 5s) apply if unset.
# MAPS_JOB_STEM_SEPARATION_ATTEMPTS=3
# MAPS_JOB_STEM_SEPARATION_BACKOFF_TYPE=exponential
# MAPS_JOB_STEM_SEPARATION_BACKOFF_DELAY_MS=5000
# MAPS_JOB_KICK_ONSET_ATTEMPTS=3
# MAPS_JOB_MELODY_EXTRACTION_ATTEMPTS=3
# MAPS_JOB_BEATMAP_ORCHESTRATION_ATTEMPTS=3
